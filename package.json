{
  "name": "session-branch-for-claude-code",
  "displayName": "Session Branch for Claude Code",
  "description": "Shows the git branch of the active Claude Code session in the status bar, right next to the workspace branch, and warns when they differ.",
  "version": "1.1.0",
  "publisher": "SergiMoreno",
  "author": {
    "name": "Sergi Moreno"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smoreno123/session-branch-for-claude-code.git"
  },
  "bugs": {
    "url": "https://github.com/smoreno123/session-branch-for-claude-code/issues"
  },
  "homepage": "https://github.com/smoreno123/session-branch-for-claude-code#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e293b",
    "theme": "dark"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "claude",
    "claude code",
    "git",
    "branch",
    "worktree",
    "status bar",
    "ai",
    "session"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeBranchStatus.info",
        "title": "Session Branch: Show Session Info"
      },
      {
        "command": "claudeBranchStatus.refresh",
        "title": "Session Branch: Refresh"
      }
    ],
    "configuration": {
      "title": "Session Branch for Claude Code",
      "properties": {
        "claudeBranchStatus.maxAgeDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Only Claude Code sessions modified in the last N days are considered."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
